        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"Draft Ready\", \"Escalate\"],\n      \"description\": \"Draft Ready if the answer is clearly supported by retrieved context, Escalate otherwise.\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Low\"]\n    },\n    \"complaint_category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Billing\",\n        \"Account Access\",\n        \"Bug\",\n        \"Feature Question\",\n        \"Integration\",\n        \"Performance\",\n        \"Refund\",\n        \"Cancellation\",\n        \"Feedback\",\n        \"Technical\",\n        \"Other\"\n      ]\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"Low\", \"Medium\", \"High\", \"Urgent\"]\n    },\n    \"draft\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Customer-facing reply text. Required if status is Draft Ready, otherwise null.\"\n    },\n    \"escalation_reason\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Brief internal note explaining why this was escalated. Required if status is Escalate, otherwise null.\"\n    }\n  },\n  \"required\": [\n    \"status\",\n    \"confidence\",\n    \"complaint_category\",\n    \"priority\",\n    \"draft\",\n    \"escalation_reason\"\n  ],\n  \"additionalProperties\": false\n}"
